# Copy to .env.langfuse and keep that file local. Never commit real keys.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me

# Metadata-only tracing is the safe default for RootWalk.
ROOTWALK_OTEL_ENABLED=true
ROOTWALK_OTEL_CAPTURE_CONTENT=false
ROOTWALK_OTEL_SAMPLE_RATIO=1.0
